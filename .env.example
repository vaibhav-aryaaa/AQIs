# SmartAQI API Configuration Template
# Rename this file to .env and fill in your keys.

# Google Gemini API Key (Get a free developer key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Alerts Configuration (Optional - BotFather Setup)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
